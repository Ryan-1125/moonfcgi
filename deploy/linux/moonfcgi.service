[Unit]
Description=MoonFCGI FastCGI application service
After=network.target

[Service]
Type=simple
User=moonfcgi
Group=www-data
RuntimeDirectory=moonfcgi
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/moonfcgi
ExecStart=/opt/moonfcgi/moonfcgi-service
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
